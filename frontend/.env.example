# ─── Sentinel Frontend Environment Variables ──────────────────────────────────
#
# Copy this file to .env and fill in values for your environment.
# Without VITE_API_URL the frontend uses local mock data (Phase 1–3 behaviour).

# Backend API base URL — set this to enable live backend integration.
# Example: https://sentinel-api.your-domain.com
# VITE_API_URL=
